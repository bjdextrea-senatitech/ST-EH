$TTL 3600
@       IN SOA  ns1.qhapaq.lab. ti.qhapaq.lab. (
                2026111501 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                300 )      ; minimum
        IN NS   ns1.qhapaq.lab.
        IN MX 10 mail.qhapaq.lab.
        IN TXT  "v=spf1 mx ip4:10.30.0.25 -all"
        IN HINFO "Ubuntu 24.04" "Data center Arequipa"

ns1         IN A     10.30.0.53
www         IN A     10.30.0.10
intranet    IN CNAME www
dev         IN CNAME www
mail        IN A     10.30.0.25
webmail     IN CNAME mail
files       IN A     10.30.0.45
backup-2019 IN A     10.30.0.45
db          IN A     10.30.0.60
monitor     IN A     10.30.0.161
vpn         IN A     10.30.0.200
jenkins     IN A     10.30.0.70
; El ERP lo administra el proveedor Andes Cloud: está en nuestro DNS, pero NO es nuestro
erp         IN A     10.30.0.250
_flag       IN TXT   "QHAPAQ{05-transferencia-de-zona-abierta}"
